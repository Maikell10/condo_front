{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "condo-front-seven.vercel.app" }],
      "destination": "https://www.condominioaunclic.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
